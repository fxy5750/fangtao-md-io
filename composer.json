{
  "name": "fangtao/md-io",
  "description": "Import and export Markdown documents, ZIP archives, and related media in WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "cebe/markdown": "1.2.1",
    "erusev/parsedown": "1.8.0",
    "erusev/parsedown-extra": "0.8.1",
    "symfony/polyfill-mbstring": "^1.31"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
