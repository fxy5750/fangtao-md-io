msgstr "Settings"

msgid "请选择一个 Markdown 或 ZIP 文件。"
msgstr "Please choose a Markdown or ZIP file."

msgid "远程图片下载失败（%1$s）：%2$s"
msgstr "Remote image download failed (%1$s): %2$s"

