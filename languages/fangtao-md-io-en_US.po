msgstr "A standalone Markdown file can be uploaded directly. If content references local assets, package the Markdown file and assets in a ZIP with relative paths. Only assets referenced in content are added to the Media Library."

msgid "自动导入远程图片"
msgstr "Import remote images automatically"

msgid "草稿"
msgstr "Draft"

msgid "视频"
msgstr "Video"

msgid "视频可使用 WordPress 短代码，其他素材可使用普通 Markdown 链接："
msgstr "Use WordPress shortcodes for video. Use normal Markdown links for other assets:"

msgid "解压总量上限（MB）"
msgstr "Extracted content limit (MB)"

