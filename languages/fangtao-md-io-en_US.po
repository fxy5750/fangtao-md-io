msgstr "The PHP DOM extension is not enabled, so post content cannot be converted."

msgid "服务器未启用 PHP ZIP 或 zlib 扩展，无法创建压缩包。"
msgstr "Neither PHP ZIP nor zlib is enabled, so an archive cannot be created."

msgid "服务器未启用 PHP ZIP 扩展，ZIP 导入将使用 WordPress 内置解压机制。"
msgstr "The PHP ZIP extension is unavailable. ZIP import will use WordPress built-in extraction."

msgid "服务器未启用 PHP ZIP 扩展，ZIP 导出将使用 WordPress 内置 PclZip。"
msgstr "The PHP ZIP extension is unavailable. ZIP export will use WordPress built-in PclZip."

msgid "未在导入文件中找到素材：%s"
msgstr "Asset was not found in the imported files: %s"

msgid "查看图片导入警告"
msgstr "View image import warnings"

msgid "没有可导出的内容。"
msgstr "There is no content to export."

msgid "特色图片为远程地址，但远程图片导入尚未开启。"
msgstr "The featured image is remote, but remote image importing is not enabled."

msgid "用于设置导入表单首次打开时默认选中的文章状态，单次导入仍可临时修改。"
msgstr "Sets the initially selected post status on the import form. It can still be changed for an individual import."

msgid "留空或 0 时默认为 500 个。"
msgstr "Leave blank or enter 0 to use the default of 500."

msgid "留空或填写 0 时跟随 PHP/WordPress 上传限制（当前 %s）。手动值仍受服务器自身上传限制约束。"
msgstr "Leave blank or enter 0 to follow the PHP/WordPress upload limit (currently %s). Manual values remain constrained by server upload limits."

msgid "直接上传单个 Markdown 文件，或上传包含 Markdown、图片、音视频和文档素材的 ZIP。每个 Markdown 文件会创建一篇内容。"
msgstr "Upload a single Markdown file, or a ZIP containing Markdown, images, audio, video, and document assets. Each Markdown file creates one content item."

msgid "立即发布"
msgstr "Publish immediately"

