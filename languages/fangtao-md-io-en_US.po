msgstr "Post date"

msgid "文章日期格式无效。"
msgstr "The post date format is invalid."

msgid "留空则使用当前时间；可精确到秒。"
msgstr "Leave empty to use the current time. Seconds are supported."

msgid "可见性"
msgstr "Visibility"

