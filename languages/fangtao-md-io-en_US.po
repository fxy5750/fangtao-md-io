msgstr "When enabled, HTTP(S) images in content and featured images are downloaded to the Media Library. Disabled by default."

msgid "当前 Markdown 风格："
msgstr "Current Markdown style:"

msgid "您没有修改插件设置的权限。"
msgstr "You do not have permission to change plugin settings."

msgid "您没有导入文章的权限。"
msgstr "You do not have permission to import content."

msgid "您没有导出所选内容的权限。"
msgstr "You do not have permission to export the selected content."

msgid "您没有导出文章的权限。"
msgstr "You do not have permission to export content."

msgid "所选内容类型不可导出。"
msgstr "The selected content type cannot be exported."

msgid "打开对应内容列表。单篇内容使用标题下方的“导出 Markdown”；多篇内容先勾选，再从“批量操作”中选择“导出 Markdown ZIP”。"
msgstr "Open the relevant content list. For one item, use Export Markdown below its title. For multiple items, select them and choose Export Markdown ZIP from Bulk actions."

msgid "批量导出时，每篇内容会放入独立目录，目录内仍保持相同结构。"
msgstr "For bulk exports, each item is placed in its own directory with the same internal structure."

msgid "批量筛选导出"
msgstr "Bulk filtered export"

msgid "支持 .md、.markdown、.mdown、.mkdn、.mkd、.mdwn、.mdtxt、.mdtext、.文本、.txt 和 .zip 文件，不区分扩展名大小写。"
msgstr "Supports .md, .markdown, .mdown, .mkdn, .mkd, .mdwn, .mdtxt, .mdtext, .text, .txt, and .zip files, case-insensitively."

msgid "文件上传失败，错误代码：%d。"
msgstr "File upload failed with error code: %d."

